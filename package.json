{
  "name": "elearning-hyperframes-openshift",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone HyperFrames source-code-review render service for OpenShift",
  "type": "module",
  "scripts": {
    "start": "node server.mjs",
    "test": "node --test tests/*.test.mjs",
    "render:demo": "hyperframes render --output /tmp/code-review-demo.mp4 --quality draft",
    "lint:demo": "cd composition/templates && ../../node_modules/.bin/hyperframes lint",
    "check:demo": "cd composition/templates && ../../node_modules/.bin/hyperframes check"
  },
  "dependencies": {
    "gsap": "3.14.2",
    "hyperframes": "0.9.87",
    "microsoft-cognitiveservices-speech-sdk": "^1.53.0"
  },
  "engines": {
    "node": ">=22"
  }
}
